# Hakim
HAKIM_API_KEY=hk_live_...
# Optional: pin a region instead of "auto" (de | uae | ksa). Leave unset
# to let Hakim route to the closest healthy region.
HAKIM_REGION=auto
# Optional: point at a non-production Hakim deployment. Overrides HAKIM_REGION.
# HAKIM_BASE_URL=https://de.api.tryhakim.ai

# LiveKit (your existing LiveKit Cloud project or self-hosted server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...

# Voice used by the example agent — replace with one of your own
# Hakim voice ids/slugs (Dashboard -> Voices).
HAKIM_VOICE=cmokbc2b1001pvu39wmj61b7h
